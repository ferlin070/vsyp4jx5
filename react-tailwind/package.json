{
  "name": "ponytail-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React + TypeScript + Tailwind variant of Ponytail Pro Max. The 7 weapons ported to hooks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/sizecheck.mjs",
    "verify": "node scripts/verify.mjs",
    "init": "node scripts/init.mjs",
    "deploy": "node scripts/deploy.mjs",
    "brief": "node scripts/brief.mjs",
    "seed": "node scripts/seed.mjs",
    "audit": "node scripts/audit.mjs",
    "submit": "node scripts/submit.mjs",
    "scaffold": "node scripts/scaffold.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
